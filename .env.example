# Surge POS — environment contract.
# Copy to .env.local and fill in. `lib/env.ts` validates these at startup:
# in production a missing PRODUCTION-REQUIRED var throws; dev/sandbox only warns.

# --- Supabase (production-required) ---
# NOTE: the app reads NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (the publishable/anon
# key), not *_ANON_KEY. SUPABASE_URL is an optional non-public fallback used by a
# few server routes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=

# --- Canonical hosts (production-required) ---
NEXT_PUBLIC_SITE_URL=https://www.surgetechpos.com
NEXT_PUBLIC_APP_URL=https://app.surgetechpos.com

# --- Jobs / notifications ---
CRON_SECRET=
RESEND_API_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Finix payments (production-required when taking real cards) ---
FINIX_USERNAME=
FINIX_PASSWORD=
FINIX_ENVIRONMENT=sandbox
FINIX_APPLICATION_ID=
FINIX_MERCHANT_ID=
FINIX_DEVICE_ID=
FINIX_WEBHOOK_SIGNING_KEY=

# --- AI (dev-optional) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Delivery webhooks (required only once delivery is enabled) ---
DELIVERY_DOORDASH_SIGNING_SECRET=
DELIVERY_UBEREATS_SIGNING_SECRET=
DELIVERY_SKIP_SIGNING_SECRET=

# --- Deliverect (3rd-party delivery aggregation) ---
DELIVERECT_WEBHOOK_SECRET=
